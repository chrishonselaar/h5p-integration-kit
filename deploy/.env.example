# Public https URLs (the LMS stores LTI_PUBLIC_URL at registration: choose it first)
H5P_PUBLIC_URL=https://h5p.example.org
LTI_PUBLIC_URL=https://lti.example.org

# Secrets: make each with `openssl rand -base64 32`
H5P_ADMIN_PASSWORD=
H5P_TOOL_SECRET=
LTI_SECRET_KEY=
POSTGRES_PASSWORD=
# Optional: LMS admins need ?key=<this> in the registration URL
LTI_REGISTRATION_KEY=

# Local ports the reverse proxy forwards to
H5P_PORT=3000
LTI_PORT=5001
