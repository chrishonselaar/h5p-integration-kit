# Demo-only settings shared by the H5P server and the LTI tool. Not for production: make your
# own secrets (e.g. `openssl rand -base64 32`).
#   set -a; . demo/moodle/demo.env; set +a
H5P_BASE_URL=http://localhost:3000
H5P_ADMIN_PASSWORD=demo-admin-password
H5P_TOOL_SECRET=demo-tool-secret-shared-by-h5p-server-and-tool
APP_URL=http://localhost:5001
H5P_SERVER=http://localhost:3000
H5P_API_TOKEN=demo-admin-password
SECRET_KEY=demo-flask-secret
HOST=0.0.0.0
